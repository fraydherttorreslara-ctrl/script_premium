-- ===================== MÉTODO XEROHUB (protegido) =====================
task.spawn(function()
    local function getRequest()
        return (syn and syn.request) or (http and http.request) or http_request or request
    end

    local function getAssetFn()
        return getcustomasset or getsynasset
    end

    local function hash(text)
        local h = 5381
        text = tostring(text or "")
        for i = 1, #text do
            h = (h * 33 + string.byte(text, i)) % 2147483647
        end
        return tostring(h)
    end

    local function payloadType(data)
        if type(data) \~= "string" or #data < 12 then return nil end
        if data:sub(1, 8) == "\137PNG\r\n\26\n" then return "png" end
        if data:byte(1) == 0xFF and data:byte(2) == 0xD8 then return "jpg" end
        if data:sub(1, 4) == "RIFF" and data:sub(9, 12) == "WEBP" then return "webp" end
        return nil
    end

    local function extractImage(html)
        if type(html) \~= "string" then return nil end
        local patterns = {
            'property=["\']og:image["\'][^>]-content=["\']([^"\']+)["\']',
            'content=["\']([^"\']+)["\'][^>]-property=["\']og:image["\']',
            '(https://i%.pinimg%.com/[^"\'%s]+)',
            '(https:\\/\\/i%.pinimg%.com\\/[^"\\]+)',
        }
        for _, p in ipairs(patterns) do
            local found = html:match(p)
            if found then
                found = found:gsub("\\/", "/"):gsub("&amp;", "&")
                if found:find("^https?://") then return found end
            end
        end
        return nil
    end

    local function resolve(url)
        local req = getRequest()
        local current = url
        local seen = {}

        for _ = 1, 5 do
            if not current or seen[current] then break end
            seen[current] = true

            local body, status, location

            if req then
                local ok, res = pcall(req, {
                    Url = current,
                    Method = "GET",
                    Headers = {
                        ["User-Agent"] = "Mozilla/5.0",
                        ["Accept"] = "text/html,image/*,*/*",
                        ["Referer"] = "https://www.pinterest.com/",
                    },
                })
                if ok and res then
                    status = tonumber(res.StatusCode or res.Status)
                    body = type(res.Body) == "string" and res.Body or nil
                    if type(res.Headers) == "table" then
                        for k, v in pairs(res.Headers) do
                            if tostring(k):lower() == "location" then
                                location = tostring(v)
                            end
                        end
                    end
                end
            else
                local ok, data = pcall(game.HttpGet, game, current)
                if ok and type(data) == "string" then
                    body, status = data, 200
                end
            end

            if status and status >= 300 and status < 400 and location then
                current = location:sub(1, 1) == "/" and ("https://www.pinterest.com" .. location) or location
            elseif body then
                local kind = payloadType(body)
                if kind then return body, kind end
                local nextUrl = extractImage(body)
                if nextUrl then current = nextUrl else break end
            else
                break
            end
        end
        return nil
    end

    local function loadAsset(url, fallback)
        local assetFn = getAssetFn()
        if not assetFn or type(writefile) \~= "function" then
            return fallback
        end

        pcall(function()
            if isfolder and not isfolder("XeroHub") then makefolder("XeroHub") end
            if isfolder and not isfolder("XeroHub/Backgrounds") then makefolder("XeroHub/Backgrounds") end
        end)

        local base = "XeroHub/Backgrounds/bg_" .. hash(url)

        for _, ext in ipairs({ ".jpg", ".png", ".webp" }) do
            local path = base .. ext
            if isfile and isfile(path) then
                local ok, asset = pcall(assetFn, path)
                if ok and type(asset) == "string" and asset \~= "" then
                    return asset
                end
            end
        end

        local body, kind = resolve(url)
        if body and kind then
            local ext = (kind == "png" and ".png") or (kind == "webp" and ".webp") or ".jpg"
            local path = base .. ext
            if pcall(writefile, path, body) then
                local ok, asset = pcall(assetFn, path)
                if ok and type(asset) == "string" and asset \~= "" then
                    return asset
                end
            end
        end

        return fallback
    end

    -- Cargar fondos
    local ok1, menuAsset = pcall(loadAsset, PIN_MENU, FALLBACK_MENU)
    local ok2, iconAsset = pcall(loadAsset, PIN_ICON, FALLBACK_ICON)

    if ok1 and menuAsset and bg and bg.Parent then
        bg.Image = menuAsset
        pcall(function() ContentProvider:PreloadAsync({ bg }) end)
    end
    if ok2 and iconAsset and iconBtn and iconBtn.Parent then
        iconBtn.Image = iconAsset
        pcall(function() ContentProvider:PreloadAsync({ iconBtn }) end)
    end
end)

-- ===================== ARRASTRAR / BOTONES =====================
local dragging, dragStart, startPos

local function beginDrag(input, obj)
    dragging = true
    dragStart = input.Position
    startPos = obj.Position
    local conn
    conn = input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.End then
            dragging = false
            if conn then conn:Disconnect() end
        end
    end)
end

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        beginDrag(input, frame)
    end
end)

iconBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        beginDrag(input, iconBtn)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        local obj = frame.Visible and frame or iconBtn
        obj.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

